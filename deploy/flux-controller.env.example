FLUX_ENROLL_ADDRESS=:8443
FLUX_CONTROL_ADDRESS=:9443
FLUX_PUBLIC_ENROLL_ADDRESS=controller.example.com:8443
FLUX_PUBLIC_CONTROL_ADDRESS=controller.example.com:9443
FLUX_NODE_INSTALLER_URL=https://github.com/your-org/flux/releases/download/v1.0.0/install.sh
FLUX_NODE_RELEASE_URL=https://github.com/your-org/flux/releases/download/v1.0.0/flux-v1.0.0.tar.gz
FLUX_MANAGEMENT_COOKIE_SECURE=true
FLUX_MANAGEMENT_SESSION_TTL=24h
FLUX_MANAGEMENT_PLAN_ID=edge-prod
FLUX_WEB_ROOT=/opt/flux/web
FLUX_SNAPSHOT_POLL_INTERVAL=5s
FLUX_PING_INTERVAL=30s
FLUX_AUTH_CHECK_INTERVAL=30s
FLUX_HEARTBEAT_TIMEOUT=95s
